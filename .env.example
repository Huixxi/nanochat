# Database
DATABASE_URL=sqlite:///./nanochat.db

# AI Service — Provider toggle
AI_PROVIDER=ollama          # ollama | openai

# Ollama (local, default)
OLLAMA_URL=http://localhost:11434
AI_MODEL=qwen2.5:0.5b

# OpenAI-compatible (cloud, used when AI_PROVIDER=openai)
AI_API_KEY=                 # your API key (DeepSeek, OpenAI, etc.)
AI_API_BASE=https://api.deepseek.com/v1
AI_MODEL_CLOUD=deepseek-chat

# Redis (optional, for future use)
REDIS_URL=redis://localhost:6379

# JWT Secret (change in production!)
JWT_SECRET=nanochat-dev-secret-change-me

# Server
API_PORT=8000
FRONTEND_PORT=3000
